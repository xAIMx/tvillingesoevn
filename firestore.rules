rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{familyId} {
      allow read, write: if request.auth != null && request.auth.uid == familyId;
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == familyId;
      }
    }
  }
}
